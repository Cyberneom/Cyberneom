{
  "hosting": {
    "public": "../build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.map",
      "**/*service_account*",
      "**/*service-account*",
      "**/*.pem",
      "**/*.key",
      "**/privacy_policy.review.json"
    ],
    "headers": [
      {
        "source": "/assets/assets/legal/{account_deletion,terms_conditions}.md",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }
        ]
      },
      {
        "source": "/assets/assets/privacy_policy.{md,json}",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }
        ]
      },
      {
        "source": "/eliminar-cuenta{,/**}",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" },
          { "key": "Content-Type", "value": "text/html; charset=utf-8" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "no-referrer" }
        ]
      },
      {
        "source": "/terminos-y-condiciones{,/**}",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" },
          { "key": "Content-Type", "value": "text/html; charset=utf-8" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "no-referrer" }
        ]
      },
      {
        "source": "/politica-de-privacidad{,/**}",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" },
          { "key": "Content-Type", "value": "text/html; charset=utf-8" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "no-referrer" }
        ]
      }
    ],
    "redirects": [
      {
        "regex": "^/terminos-de-servicio/?$",
        "destination": "/terminos-y-condiciones/",
        "type": 301
      },
      {
        "regex": "^/eliminar-cuenta$",
        "destination": "/eliminar-cuenta/",
        "type": 301
      },
      {
        "regex": "^/terminos-y-condiciones$",
        "destination": "/terminos-y-condiciones/",
        "type": 301
      },
      {
        "regex": "^/politica-de-privacidad$",
        "destination": "/politica-de-privacidad/",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/eliminar-cuenta/",
        "destination": "/eliminar-cuenta/index.html"
      },
      {
        "source": "/terminos-y-condiciones/",
        "destination": "/terminos-y-condiciones/index.html"
      },
      {
        "source": "/politica-de-privacidad/",
        "destination": "/politica-de-privacidad/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
