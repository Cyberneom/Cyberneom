{
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/node_modules/**",
      "**/*.map",
      "**/*service_account*",
      "**/*service-account*",
      "**/*.pem",
      "**/*.key",
      "**/.git/**",
      "**/.env*"
    ],
    "headers": [
      {
        "source": "/.well-known/apple-app-site-association",
        "headers": [
          { "key": "Content-Type", "value": "application/json" }
        ]
      },
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          { "key": "Content-Type", "value": "application/json" }
        ]
      },
      {
        "source": "**/*.@(js|css|html|json|wasm)",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }
        ]
      }
    ],
    "redirects": [
      {
        "regex": "^/([^/]+/)+(main\\.dart\\.js_[0-9]+\\.part\\.js)$",
        "destination": "/:2",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/api/og/x/**",
        "function": "stateOgMeta"
      },
      {
        "source": "/x/**",
        "destination": "/state.html"
      },
      {
        "source": "/generator",
        "destination": "/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ]
}
